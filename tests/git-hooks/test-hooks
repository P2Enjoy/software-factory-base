new_repo
mkdir -p "$repo/subdir"
cp -R "$source_root/.githooks" "$repo/.githooks"
mkdir -p "$repo/scripts"
cp -R "$source_root/scripts/git-hooks" "$repo/scripts/git-hooks"
expect_success "install fonctionne depuis un sous-répertoire" \
  bash -c 'cd "$1/subdir" && "$1/scripts/git-hooks/install" --worker' _ "$repo"
expect_success "install est idempotent" \
  bash -c 'cd "$1" && "$1/scripts/git-hooks/install" --worker' _ "$repo"
[[ "$(git -C "$repo" config --local --get core.hooksPath)" == ".githooks" ]] || fail "install configure core.hooksPath"
[[ "$(git -C "$repo" config --local --get factory.hooks.mode)" == "worker" ]] || fail "install configure le mode worker"
git -C "$repo" config --local core.hooksPath custom-hooks
expect_failure "install préserve un chemin de hooks préexistant" \
  bash -c 'cd "$1" && "$1/scripts/git-hooks/install"' _ "$repo"
[[ "$(git -C "$repo" config --local --get core.hooksPath)" == "custom-hooks" ]] || fail "install ne remplace pas les hooks existants"

new_repo
cp -R "$source_root/.githooks" "$repo/.githooks"
mkdir -p "$repo/scripts"
cp -R "$source_root/scripts/git-hooks" "$repo/scripts/git-hooks"
(cd "$repo" && scripts/git-hooks/install --worker >/dev/null)
printf '# @spec docs/AUTOMATION.md#pre-commit-hook\nprint("ok")\n' >"$repo/app.py"
