#!/usr/bin/env bash
# @spec docs/AUTOMATION.md#local-guards
# @verifies docs/AUTOMATION.md#hook-installation | docs/AUTOMATION.md#local-guards | docs/AUTOMATION.md#session-guard
set -euo pipefail

source_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
test_root="$(mktemp -d "${TMPDIR:-/tmp}/factory-hooks.XXXXXX")"
output_file="$test_root/output"
passes=0
failures=0
repo=""

cleanup() {
  rm -rf -- "$test_root"
}
trap cleanup EXIT

pass() {
  printf 'OK   %s\n' "$1"
  passes=$((passes + 1))
}

fail() {
  printf 'FAIL %s\n' "$1" >&2
  if [[ -s "$output_file" ]]; then
    sed 's/^/     /' "$output_file" >&2
  fi
  failures=$((failures + 1))
}

expect_success() {
  local label="$1"
  shift
  : >"$output_file"
  if "$@" >"$output_file" 2>&1; then
    pass "$label"
  else
    fail "$label"
  fi
}

expect_failure() {
  local label="$1"
  shift
  : >"$output_file"
  if "$@" >"$output_file" 2>&1; then
    fail "$label (succès inattendu)"
  else
    pass "$label"
  fi
}

new_repo() {
  repo="$(mktemp -d "$test_root/repo.XXXXXX")"
  git -C "$repo" init -q -b main
  git -C "$repo" config --local user.name P2Enjoy
  git -C "$repo" config --local user.email contact@p2enjoy.studio
  printf '# Fixture\n' >"$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit -q -m "Initialise la fixture"
}

run_staged() {
  (cd "$repo" && "$source_root/scripts/git-hooks/check-staged")
}

run_staged_with_bad_author_override() {
  (cd "$repo" && GIT_AUTHOR_NAME=Intrus GIT_AUTHOR_EMAIL=intrus@example.test \
    "$source_root/scripts/git-hooks/check-staged")
}

run_message() {
  "$source_root/scripts/git-hooks/check-message" "$1"
}

run_push() {
  local remote="$1" update="$2"
  printf '%s\n' "$update" |
    (cd "$repo" && "$source_root/scripts/git-hooks/check-push" "$remote" example.invalid)
}

run_session() {
  (cd "$repo" && "$source_root/scripts/git-hooks/check-session")
}

new_repo
printf '# @spec docs/AUTOMATION.md#pre-commit-hook\nprint("ok")\n' >"$repo/app.py"
git -C "$repo" add app.py
expect_success "pre-commit accepte identité et traçabilité valides" run_staged

new_repo
printf '# @spec docs/AUTOMATION.md#pre-commit-hook\nprint("ok")\n' >"$repo/app.py"
git -C "$repo" add app.py
git -C "$repo" config --local --unset-all user.name
expect_failure "pre-commit refuse une identité locale absente" run_staged

new_repo
printf '# @spec docs/AUTOMATION.md#pre-commit-hook\nprint("ok")\n' >"$repo/app.py"
git -C "$repo" add app.py
git -C "$repo" config --local --unset-all user.email
