git -C "$repo" remote add origin "$bare_remote"
expect_success "le hook pre-push installé accepte un push réel vers un dépôt temporaire" \
  git -C "$repo" push -q origin main
expect_success "le hook pre-push installé accepte un push réel déjà à jour" \
  git -C "$repo" push -q origin main
