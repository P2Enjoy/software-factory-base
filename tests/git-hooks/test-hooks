git -C "$repo" add README.md
expect_failure "le hook commit-msg installé refuse une signature" \
  git -C "$repo" commit -q -m "Generated by Codex"
git -C "$repo" -c core.hooksPath=/dev/null commit -q \
  --author='Intrus <intrus@example.test>' -m "Crée une fixture non conforme"
expect_failure "le hook pre-push installé bloque un commit non conforme" \
  git -C "$repo" push -q origin main

new_repo
base_oid="$(git -C "$repo" rev-parse HEAD)"
git -C "$repo" config --local factory.hooks.mode worker
git -C "$repo" config --local factory.hooks.baseline "$base_oid"
printf 'suite\n' >>"$repo/README.md"
git -C "$repo" add README.md
git -C "$repo" commit -q -m "Ajoute une évolution"
head_oid="$(git -C "$repo" rev-parse HEAD)"
update="refs/heads/main $head_oid refs/heads/main $base_oid"
expect_success "pre-push accepte origin/main en fast-forward" run_push origin "$update"
first_push_update="refs/heads/main $head_oid refs/heads/main $(printf '0%.0s' {1..40})"
expect_success "pre-push utilise la baseline lors d'un premier push" run_push origin "$first_push_update"
expect_success "pre-push accepte un push déjà à jour" run_push origin ""
expect_failure "pre-push refuse un autre remote en mode worker" run_push miroir "$update"
non_fast_forward="refs/heads/main $base_oid refs/heads/main $head_oid"
expect_failure "pre-push refuse une mise à jour non fast-forward" run_push origin "$non_fast_forward"
deletion="refs/heads/main $(printf '0%.0s' {1..40}) refs/heads/main $head_oid"
expect_failure "pre-push refuse la suppression de main" run_push origin "$deletion"
tag_update="refs/tags/v1 $head_oid refs/tags/v1 $(printf '0%.0s' {1..40})"
